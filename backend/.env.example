# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
# Shared secret your phone uses to connect. Open the app once as https://your-server/?token=THIS
BUDDY_TOKEN=change-me-to-a-long-random-string
BUDDY_USER_NAME=Aneesh
BUDDY_NAME=Buddy
BUDDY_TIMEZONE=Asia/Kolkata
# Local time for the daily spoken briefing (HH:MM); empty to disable
BUDDY_MORNING_BRIEF=08:00
BUDDY_MODEL=claude-opus-5
BUDDY_EFFORT=low
BUDDY_DB=buddy.db
