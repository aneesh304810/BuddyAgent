# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
# Shared secret your phone uses to connect. Open the app once as https://your-server/?token=THIS
BUDDY_TOKEN=change-me-to-a-long-random-string
BUDDY_USER_NAME=Aneesh
BUDDY_NAME=Buddy
# Fallback only: Buddy follows the phone's time zone as you travel
BUDDY_TIMEZONE=America/New_York
# Languages you understand. Listen-in only gives you the gist of other languages.
BUDDY_KNOWN_LANGUAGES=English, Hindi, Malayalam, Marathi, Tamil
# Local time for the daily spoken briefing (HH:MM); empty to disable
BUDDY_MORNING_BRIEF=08:00
BUDDY_MODEL=claude-opus-5
BUDDY_EFFORT=low
BUDDY_DB=buddy.db
# 64 hex characters (openssl rand -hex 32). Encrypts the database. Leave empty only for local dev.
BUDDY_DB_KEY=
# Specialist agents (copy agents.example.yaml to agents.yaml)
BUDDY_AGENTS=agents.yaml
# Buddy stops calling Claude once this month's estimated spend reaches this (USD)
BUDDY_MONTHLY_BUDGET_USD=40
